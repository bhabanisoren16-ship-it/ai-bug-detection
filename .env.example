# ==============================================================================
# SECURE ENVIRONMENT TEMPLATE (.env.example)
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING PRODUCTION SECRETS TO GIT
# ==============================================================================

# Web Server Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1

# Security & Defensive Shield Settings
SECRET_KEY=replace_with_cryptographically_secure_random_key_64_chars_min
MAX_CONTENT_LENGTH=2097152  # 2MB Limit against memory exhaustion DoS
RATE_LIMIT_PER_MINUTE=240   # BeyondCorp Token Bucket Throttling

# Automated Access Restrictions
RESTRICT_BOT_CRAWLERS=true
BLOCK_GOOGLE_SERVICES=true

# External Secret Vault / Key Management
# In production, inject secrets directly via your cloud provider (Vercel, AWS Secrets Manager, GCP Secret Manager)
# API_KEY=
# VAULT_TOKEN=
